generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  ADMIN
  MEMBER
}

enum VariableKind {
  PLAIN
  SECRET
}

enum RequirementStatus {
  DESIGN
  DEVELOPMENT
  TESTING
  COMPLETED
}

enum TestPriority {
  P0
  P1
  P2
}

enum RunStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  TIMED_OUT
  STOPPED
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         UserRole  @default(MEMBER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  sessions      Session[]
  requestedRuns TestRun[]

  @@index([deletedAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  baseUrl     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  repositories Repository[]
  variables    ProjectVariable[]
  features     Feature[]
  userStories  UserStory[]
  testGroups   TestCaseGroup[]
  testCases    TestCase[]

  @@index([deletedAt])
  @@index([updatedAt])
}

model Repository {
  id        String    @id @default(cuid())
  projectId String
  gitUrl    String
  branch    String
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, deletedAt])
}

model ProjectVariable {
  id          String       @id @default(cuid())
  projectId   String
  name        String
  value       String
  description String?
  kind        VariableKind @default(PLAIN)
  position    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, deletedAt])
}

model Feature {
  id             String    @id @default(cuid())
  projectId      String
  code           String    @unique
  name           String
  summary        String
  backgroundGoal String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  userStories UserStory[]

  @@index([projectId, deletedAt, updatedAt])
}

model UserStory {
  id                        String            @id @default(cuid())
  projectId                 String
  featureId                 String?
  code                      String            @unique
  title                     String
  asA                       String
  iWant                     String
  soThat                    String
  status                    RequirementStatus @default(DESIGN)
  businessRules             String?
  nonFunctionalRequirements String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  deletedAt                 DateTime?

  project            Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  feature            Feature?              @relation(fields: [featureId], references: [id], onDelete: Restrict)
  acceptanceCriteria AcceptanceCriterion[]
  testCaseLinks      TestCaseUserStory[]

  @@index([projectId, deletedAt, updatedAt])
  @@index([featureId, deletedAt])
}

model AcceptanceCriterion {
  id          String    @id @default(cuid())
  userStoryId String
  position    Int
  given       String
  when        String
  then        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  userStory UserStory @relation(fields: [userStoryId], references: [id], onDelete: Restrict)

  @@index([userStoryId, deletedAt, position])
}

model TestCaseGroup {
  id        String    @id @default(cuid())
  projectId String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  testCases TestCase[]

  @@index([projectId, deletedAt])
}

model TestCase {
  id            String       @id @default(cuid())
  projectId     String
  groupId       String
  code          String       @unique
  name          String
  priority      TestPriority @default(P2)
  preconditions String?
  steps         String
  enabled       Boolean      @default(true)
  script        String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  project        Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  group          TestCaseGroup       @relation(fields: [groupId], references: [id], onDelete: Restrict)
  userStoryLinks TestCaseUserStory[]
  runs           TestRun[]

  @@index([projectId, deletedAt, updatedAt])
  @@index([groupId, deletedAt])
}

model TestCaseUserStory {
  id          String    @id @default(cuid())
  testCaseId  String
  userStoryId String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  testCase  TestCase  @relation(fields: [testCaseId], references: [id], onDelete: Restrict)
  userStory UserStory @relation(fields: [userStoryId], references: [id], onDelete: Restrict)

  @@unique([testCaseId, userStoryId])
  @@index([testCaseId, deletedAt])
  @@index([userStoryId, deletedAt])
}

model TestRun {
  id                   String    @id @default(cuid())
  testCaseId           String
  requestedById        String
  status               RunStatus @default(QUEUED)
  queuedAt             DateTime  @default(now())
  startedAt            DateTime?
  finishedAt           DateTime?
  durationMs           Int?
  exitCode             Int?
  errorSummary         String?
  logContent           String?
  screenshotPath       String?
  artifactsExpireAt    DateTime
  artifactsPurgedAt    DateTime?
  cancelRequestedAt    DateTime?
  workerId             String?
  testCaseCodeSnapshot String
  testCaseNameSnapshot String
  scriptSnapshot       String
  baseUrlSnapshot      String

  testCase    TestCase @relation(fields: [testCaseId], references: [id], onDelete: Restrict)
  requestedBy User     @relation(fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([status, queuedAt])
  @@index([testCaseId, queuedAt])
  @@index([artifactsExpireAt, artifactsPurgedAt])
}

model RunnerLease {
  id        String   @id
  ownerId   String
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model BusinessCodeSequence {
  prefix        String   @id
  lastTimestamp BigInt
  updatedAt     DateTime @updatedAt
}
