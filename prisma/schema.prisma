generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  ADMIN
  MEMBER
}

enum VariableKind {
  STRING
  NUMBER
  OBJECT
}

enum VariableFieldKind {
  STRING
  NUMBER
}

enum RequirementStatus {
  DESIGN
  DEVELOPMENT
  TESTING
  COMPLETED
}

enum TestPriority {
  P0
  P1
  P2
}

enum RunStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  TIMED_OUT
  STOPPED
}

enum AiCapability {
  GENERATE_USER_STORY
  GENERATE_TEST_CASES
  GENERATE_AUTOMATION_SCRIPT
  REVIEW_REQUIREMENT_IMPLEMENTATION
}

enum AiModelCheckStatus {
  UNCHECKED
  SUCCEEDED
  FAILED
}

enum AiExecutionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum AiExecutionOrigin {
  USER
  TEST_RUN
}

enum AiExecutionStage {
  QUEUED
  CHECKING_REPOSITORIES
  SELECTING_CODE
  GENERATING_DRAFT
  REVIEWING_IMPLEMENTATION
  PREPARING_AUTHENTICATION
  PROBING_PAGE
  GENERATING_SCRIPT
  VALIDATING_SCRIPT
  COMPLETED
}

enum AiExecutionLogLevel {
  INFO
  WARN
  ERROR
}

enum AiDraftStatus {
  PENDING
  CONFIRMED
}

enum DeliveryVersionStatus {
  PENDING
  IN_PROGRESS
  DELIVERED
}

enum ImplementationReviewConclusion {
  PASSED
  FAILED
  NEEDS_CONFIRMATION
}

enum RequirementImplementationStatus {
  IMPLEMENTED
  PARTIALLY_IMPLEMENTED
  NOT_IMPLEMENTED
  UNCONFIRMED
}

enum TestCoverageStatus {
  SUFFICIENT
  INSUFFICIENT
  UNCONFIRMED
}

enum AcceptanceCriterionReviewStatus {
  SATISFIED
  VIOLATED
  UNCONFIRMED
}

enum ImplementationFindingType {
  MISSING_IMPLEMENTATION
  INCORRECT_IMPLEMENTATION
  CONFIRMED_BUG
  POTENTIAL_DEFECT
  TEST_COVERAGE_GAP
  REQUIREMENT_AMBIGUITY
}

enum ImplementationFindingSeverity {
  BLOCKER
  MAJOR
  MINOR
}

enum DeliveryVerificationCaseType {
  REQUIREMENT
  PLATFORM
}

enum TestCaseScriptSource {
  MANUAL
  AI
}

enum TestRunStage {
  QUEUED
  GENERATING_SCRIPT
  PREPARING_AUTHENTICATION
  PROBING_PAGE
  VALIDATING_SCRIPT
  RUNNING_TEST
  COMPLETED
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         UserRole  @default(MEMBER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  sessions           Session[]
  requestedRuns      TestRun[]
  aiExecutions       AiExecution[]
  createdFeatures    Feature[]                   @relation("FeatureCreatedBy")
  createdUserStories UserStory[]                 @relation("UserStoryCreatedBy")
  createdVersions    DeliveryVersion[]           @relation("DeliveryVersionCreatedBy")
  lockedVersions     DeliveryVersion[]           @relation("DeliveryVersionLockedBy")
  deliveredVersions  DeliveryVersion[]           @relation("DeliveryVersionDeliveredBy")
  verificationRuns   DeliveryVerificationBatch[]

  @@index([deletedAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id                       String    @id @default(cuid())
  name                     String
  description              String?
  baseUrl                  String?
  githubPatEncrypted       String?
  githubPatAccount         String?
  giteePatEncrypted        String?
  giteePatAccount          String?
  automationInstructions   String?
  loginMethodSource        String?
  currentDeliveryVersionId String?   @unique
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?

  repositories           Repository[]
  variables              ProjectVariable[]
  features               Feature[]
  userStories            UserStory[]
  testGroups             TestCaseGroup[]
  testCases              TestCase[]
  aiExecutions           AiExecution[]
  aiDrafts               UserStoryDraft[]
  testCaseDraftBatches   TestCaseDraftBatch[]
  deliveryVersions       DeliveryVersion[]    @relation("DeliveryVersionProject")
  currentDeliveryVersion DeliveryVersion?     @relation("CurrentDeliveryVersion", fields: [currentDeliveryVersionId], references: [id], onDelete: Restrict)

  @@index([deletedAt])
  @@index([updatedAt])
}

model DeliveryVersion {
  id            String                @id @default(cuid())
  projectId     String
  createdById   String
  lockedById    String?
  deliveredById String?
  code          String                @unique
  name          String
  description   String?
  status        DeliveryVersionStatus @default(PENDING)
  lockedAt      DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  deletedAt     DateTime?

  project               Project                     @relation("DeliveryVersionProject", fields: [projectId], references: [id], onDelete: Restrict)
  currentForProject     Project?                    @relation("CurrentDeliveryVersion")
  createdBy             User                        @relation("DeliveryVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lockedBy              User?                       @relation("DeliveryVersionLockedBy", fields: [lockedById], references: [id], onDelete: Restrict)
  deliveredBy           User?                       @relation("DeliveryVersionDeliveredBy", fields: [deliveredById], references: [id], onDelete: Restrict)
  userStories           UserStory[]
  aiExecutions          AiExecution[]
  implementationReviews ImplementationReview[]
  verificationBatches   DeliveryVerificationBatch[]

  @@index([projectId, deletedAt, createdAt])
  @@index([projectId, status, deletedAt])
  @@index([createdById])
  @@index([lockedById])
  @@index([deliveredById])
}

model Repository {
  id        String    @id @default(cuid())
  projectId String
  gitUrl    String
  branch    String
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, deletedAt])
}

model ProjectVariable {
  id          String       @id @default(cuid())
  projectId   String
  name        String
  value       String
  description String?
  kind        VariableKind @default(STRING)
  encrypted   Boolean      @default(false)
  position    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  project Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  fields  ProjectVariableField[]

  @@index([projectId, deletedAt])
}

model ProjectVariableField {
  id          String            @id @default(cuid())
  variableId  String
  name        String
  value       String
  description String?
  kind        VariableFieldKind @default(STRING)
  encrypted   Boolean           @default(false)
  position    Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  variable ProjectVariable @relation(fields: [variableId], references: [id], onDelete: Cascade)

  @@unique([variableId, name])
  @@index([variableId, position])
}

model Feature {
  id             String    @id @default(cuid())
  projectId      String
  createdById    String?
  code           String    @unique
  name           String
  summary        String
  backgroundGoal String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  project      Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdBy    User?            @relation("FeatureCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  userStories  UserStory[]
  aiExecutions AiExecution[]
  aiDrafts     UserStoryDraft[]

  @@index([projectId, deletedAt, updatedAt])
  @@index([createdById])
}

model UserStory {
  id                        String            @id @default(cuid())
  projectId                 String
  deliveryVersionId         String
  featureId                 String?
  createdById               String?
  code                      String            @unique
  title                     String
  asA                       String
  iWant                     String
  soThat                    String
  status                    RequirementStatus @default(DESIGN)
  businessRules             String?
  nonFunctionalRequirements String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  deletedAt                 DateTime?

  project                Project                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  deliveryVersion        DeliveryVersion            @relation(fields: [deliveryVersionId], references: [id], onDelete: Restrict)
  feature                Feature?                   @relation(fields: [featureId], references: [id], onDelete: Restrict)
  createdBy              User?                      @relation("UserStoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  acceptanceCriteria     AcceptanceCriterion[]
  testCases              TestCase[]
  aiTestCaseExecutions   AiExecution[]              @relation("AiTestCaseSourceUserStory")
  sourceDrafts           UserStoryDraft[]           @relation("ConfirmedUserStory")
  proposedTestCaseDrafts TestCaseDraft[]            @relation("TestCaseDraftProposedUserStory")
  implementationReviews  ImplementationReviewItem[]
  verificationItems      DeliveryVerificationItem[]

  @@index([projectId, deletedAt, updatedAt])
  @@index([createdById])
  @@index([featureId, deletedAt])
  @@index([deliveryVersionId, deletedAt])
}

model AcceptanceCriterion {
  id          String    @id @default(cuid())
  userStoryId String
  position    Int
  given       String
  when        String
  then        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  userStory UserStory @relation(fields: [userStoryId], references: [id], onDelete: Restrict)

  @@index([userStoryId, deletedAt, position])
}

model TestCaseGroup {
  id        String    @id @default(cuid())
  projectId String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  testCases      TestCase[]
  testCaseDrafts TestCaseDraft[]

  @@index([projectId, deletedAt])
}

model TestCase {
  id                  String                @id @default(cuid())
  projectId           String
  groupId             String
  userStoryId         String?
  code                String                @unique
  name                String
  priority            TestPriority          @default(P2)
  preconditions       String?
  steps               String
  enabled             Boolean               @default(true)
  script              String?
  scriptSource        TestCaseScriptSource?
  aiScriptFingerprint String?
  scriptGeneratedAt   DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  deletedAt           DateTime?

  project           Project                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  group             TestCaseGroup              @relation(fields: [groupId], references: [id], onDelete: Restrict)
  userStory         UserStory?                 @relation(fields: [userStoryId], references: [id], onDelete: Restrict)
  runs              TestRun[]
  aiExecutions      AiExecution[]
  sourceDrafts      TestCaseDraft[]            @relation("ConfirmedTestCase")
  verificationItems DeliveryVerificationItem[]

  @@index([projectId, deletedAt, updatedAt])
  @@index([groupId, deletedAt])
  @@index([userStoryId, deletedAt])
}

model TestRun {
  id                       String       @id @default(cuid())
  testCaseId               String
  requestedById            String
  status                   RunStatus    @default(QUEUED)
  stage                    TestRunStage @default(QUEUED)
  queuedAt                 DateTime     @default(now())
  startedAt                DateTime?
  finishedAt               DateTime?
  durationMs               Int?
  exitCode                 Int?
  errorSummary             String?
  logContent               String?
  screenshotPath           String?
  artifactsExpireAt        DateTime
  artifactsPurgedAt        DateTime?
  cancelRequestedAt        DateTime?
  workerId                 String?
  testCaseCodeSnapshot     String
  testCaseNameSnapshot     String
  scriptSnapshot           String?
  baseUrlSnapshot          String
  generatedScriptInRun     Boolean      @default(false)
  modelProfileNameSnapshot String?
  modelIdSnapshot          String?
  skillNameSnapshot        String?
  skillVersionSnapshot     String?
  promptTokens             Int?
  completionTokens         Int?
  totalTokens              Int?
  deletedAt                DateTime?

  testCase                 TestCase                  @relation(fields: [testCaseId], references: [id], onDelete: Restrict)
  requestedBy              User                      @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  deliveryVerificationItem DeliveryVerificationItem?

  @@index([status, deletedAt, queuedAt])
  @@index([testCaseId, deletedAt, queuedAt])
  @@index([artifactsExpireAt, artifactsPurgedAt])
}

model ImplementationReview {
  id                       String                         @id @default(cuid())
  executionId              String                         @unique
  deliveryVersionId        String
  specificationFingerprint String
  repositorySnapshot       String
  conclusion               ImplementationReviewConclusion
  createdAt                DateTime                       @default(now())

  execution       AiExecution                @relation(fields: [executionId], references: [id], onDelete: Restrict)
  deliveryVersion DeliveryVersion            @relation(fields: [deliveryVersionId], references: [id], onDelete: Restrict)
  items           ImplementationReviewItem[]

  @@index([deliveryVersionId, createdAt])
  @@index([deliveryVersionId, conclusion])
}

model ImplementationReviewItem {
  id                    String                          @id @default(cuid())
  reviewId              String
  userStoryId           String
  userStoryCodeSnapshot String
  titleSnapshot         String
  specificationSnapshot String
  implementationStatus  RequirementImplementationStatus
  coverageStatus        TestCoverageStatus
  summary               String
  createdAt             DateTime                        @default(now())

  review    ImplementationReview            @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  userStory UserStory                       @relation(fields: [userStoryId], references: [id], onDelete: Restrict)
  criteria  ImplementationReviewCriterion[]
  findings  ImplementationReviewFinding[]

  @@unique([reviewId, userStoryId])
  @@index([userStoryId, createdAt])
  @@index([reviewId, implementationStatus])
}

model ImplementationReviewCriterion {
  id            String                          @id @default(cuid())
  reviewItemId  String
  position      Int
  givenSnapshot String
  whenSnapshot  String
  thenSnapshot  String
  status        AcceptanceCriterionReviewStatus
  reason        String
  evidence      String                          @default("[]")

  reviewItem ImplementationReviewItem @relation(fields: [reviewItemId], references: [id], onDelete: Restrict)

  @@unique([reviewItemId, position])
  @@index([reviewItemId, status])
}

model ImplementationReviewFinding {
  id           String                        @id @default(cuid())
  reviewItemId String
  type         ImplementationFindingType
  severity     ImplementationFindingSeverity
  title        String
  detail       String
  evidence     String                        @default("[]")
  createdAt    DateTime                      @default(now())

  reviewItem ImplementationReviewItem @relation(fields: [reviewItemId], references: [id], onDelete: Restrict)

  @@index([reviewItemId, severity])
  @@index([reviewItemId, type])
}

model DeliveryVerificationBatch {
  id                       String   @id @default(cuid())
  deliveryVersionId        String
  requestedById            String
  specificationFingerprint String
  regressionFingerprint    String
  repositorySnapshot       String
  deploymentConfirmedAt    DateTime
  createdAt                DateTime @default(now())

  deliveryVersion DeliveryVersion            @relation(fields: [deliveryVersionId], references: [id], onDelete: Restrict)
  requestedBy     User                       @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  items           DeliveryVerificationItem[]

  @@index([deliveryVersionId, createdAt])
  @@index([requestedById])
}

model DeliveryVerificationItem {
  id                   String                       @id @default(cuid())
  batchId              String
  testCaseId           String
  testRunId            String                       @unique
  userStoryId          String?
  caseType             DeliveryVerificationCaseType
  testCaseCodeSnapshot String
  testCaseNameSnapshot String
  createdAt            DateTime                     @default(now())

  batch     DeliveryVerificationBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  testCase  TestCase                  @relation(fields: [testCaseId], references: [id], onDelete: Restrict)
  testRun   TestRun                   @relation(fields: [testRunId], references: [id], onDelete: Restrict)
  userStory UserStory?                @relation(fields: [userStoryId], references: [id], onDelete: Restrict)

  @@unique([batchId, testCaseId])
  @@index([testCaseId, createdAt])
  @@index([userStoryId])
}

model BusinessCodeSequence {
  prefix        String   @id
  lastTimestamp BigInt
  updatedAt     DateTime @updatedAt
}

model AiModelProfile {
  id              String             @id @default(cuid())
  name            String
  baseUrl         String
  modelId         String
  apiKeyEncrypted String
  lastCheckStatus AiModelCheckStatus @default(UNCHECKED)
  lastCheckedAt   DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?

  capabilityBindings AiCapabilityBinding[]

  @@index([deletedAt, name])
}

model AiCapabilityBinding {
  capability     AiCapability @id
  modelProfileId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  modelProfile AiModelProfile @relation(fields: [modelProfileId], references: [id], onDelete: Restrict)

  @@index([modelProfileId])
}

model AiExecution {
  id                       String            @id @default(cuid())
  projectId                String
  requestedById            String
  featureId                String?
  sourceUserStoryId        String?
  testCaseId               String?
  deliveryVersionId        String?
  capability               AiCapability
  origin                   AiExecutionOrigin @default(USER)
  status                   AiExecutionStatus @default(QUEUED)
  stage                    AiExecutionStage  @default(QUEUED)
  requirementText          String
  modelProfileNameSnapshot String?
  modelIdSnapshot          String?
  skillNameSnapshot        String?
  skillVersionSnapshot     String?
  repositorySnapshot       String?
  codeReferences           String?
  promptTokens             Int?
  completionTokens         Int?
  totalTokens              Int?
  errorMessage             String?
  queuedAt                 DateTime          @default(now())
  startedAt                DateTime?
  finishedAt               DateTime?
  durationMs               Int?
  workerId                 String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  deletedAt                DateTime?

  project              Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  requestedBy          User                  @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  feature              Feature?              @relation(fields: [featureId], references: [id], onDelete: Restrict)
  sourceUserStory      UserStory?            @relation("AiTestCaseSourceUserStory", fields: [sourceUserStoryId], references: [id], onDelete: Restrict)
  testCase             TestCase?             @relation(fields: [testCaseId], references: [id], onDelete: Restrict)
  deliveryVersion      DeliveryVersion?      @relation(fields: [deliveryVersionId], references: [id], onDelete: Restrict)
  testCaseDraftBatch   TestCaseDraftBatch?
  logs                 AiExecutionLog[]
  userStoryDrafts      UserStoryDraft[]
  implementationReview ImplementationReview?

  @@index([status, queuedAt])
  @@index([projectId, deletedAt, queuedAt])
  @@index([featureId])
  @@index([sourceUserStoryId])
  @@index([testCaseId])
  @@index([deliveryVersionId])
  @@index([origin])
}

model AiExecutionLog {
  id          String              @id @default(cuid())
  executionId String
  position    Int
  level       AiExecutionLogLevel
  stage       AiExecutionStage?
  message     String
  createdAt   DateTime            @default(now())

  execution AiExecution @relation(fields: [executionId], references: [id], onDelete: Restrict)

  @@unique([executionId, position])
  @@index([executionId, createdAt])
}

model UserStoryDraft {
  id                        String        @id @default(cuid())
  projectId                 String
  featureId                 String?
  sourceExecutionId         String
  confirmedUserStoryId      String?
  status                    AiDraftStatus @default(PENDING)
  title                     String
  asA                       String
  iWant                     String
  soThat                    String
  businessRules             String?
  nonFunctionalRequirements String?
  confirmedAt               DateTime?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  deletedAt                 DateTime?

  project            Project                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  feature            Feature?                   @relation(fields: [featureId], references: [id], onDelete: Restrict)
  sourceExecution    AiExecution                @relation(fields: [sourceExecutionId], references: [id], onDelete: Restrict)
  confirmedUserStory UserStory?                 @relation("ConfirmedUserStory", fields: [confirmedUserStoryId], references: [id], onDelete: Restrict)
  acceptanceCriteria DraftAcceptanceCriterion[]

  @@index([projectId, deletedAt, updatedAt])
  @@index([featureId, deletedAt])
  @@index([sourceExecutionId])
  @@index([confirmedUserStoryId])
}

model DraftAcceptanceCriterion {
  id        String    @id @default(cuid())
  draftId   String
  position  Int
  given     String
  when      String
  then      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  draft UserStoryDraft @relation(fields: [draftId], references: [id], onDelete: Restrict)

  @@index([draftId, deletedAt, position])
}

model TestCaseDraftBatch {
  id                String    @id @default(cuid())
  projectId         String
  sourceExecutionId String    @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  project         Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  sourceExecution AiExecution     @relation(fields: [sourceExecutionId], references: [id], onDelete: Restrict)
  drafts          TestCaseDraft[]

  @@index([projectId, deletedAt, updatedAt])
}

model TestCaseDraft {
  id                  String        @id @default(cuid())
  batchId             String
  groupId             String?
  proposedUserStoryId String?
  confirmedTestCaseId String?
  position            Int
  name                String
  priority            TestPriority
  preconditions       String?
  steps               String
  status              AiDraftStatus @default(PENDING)
  confirmedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  batch             TestCaseDraftBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  group             TestCaseGroup?     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  proposedUserStory UserStory?         @relation("TestCaseDraftProposedUserStory", fields: [proposedUserStoryId], references: [id], onDelete: Restrict)
  confirmedTestCase TestCase?          @relation("ConfirmedTestCase", fields: [confirmedTestCaseId], references: [id], onDelete: Restrict)

  @@index([batchId, deletedAt, position])
  @@index([groupId, deletedAt])
  @@index([proposedUserStoryId, deletedAt])
  @@index([status, deletedAt])
  @@index([confirmedTestCaseId])
}

model TaskSchedulerLease {
  id        String   @id
  ownerId   String
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}
