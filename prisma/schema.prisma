generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  ADMIN
  MEMBER
}

enum VariableKind {
  PLAIN
  SECRET
}

enum RequirementStatus {
  DESIGN
  DEVELOPMENT
  TESTING
  COMPLETED
}

enum TestPriority {
  P0
  P1
  P2
}

enum RunStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  TIMED_OUT
  STOPPED
}

enum AiCapability {
  GENERATE_USER_STORY
  GENERATE_TEST_CASES
  GENERATE_AUTOMATION_SCRIPT
}

enum AiModelCheckStatus {
  UNCHECKED
  SUCCEEDED
  FAILED
}

enum AiExecutionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum AiExecutionStage {
  QUEUED
  CHECKING_REPOSITORIES
  SELECTING_CODE
  GENERATING_DRAFT
  PROBING_PAGE
  GENERATING_SCRIPT
  VALIDATING_SCRIPT
  COMPLETED
}

enum AiExecutionLogLevel {
  INFO
  WARN
  ERROR
}

enum AiDraftStatus {
  PENDING
  CONFIRMED
}

enum TestCaseScriptSource {
  MANUAL
  AI
}

enum TestRunStage {
  QUEUED
  GENERATING_SCRIPT
  PROBING_PAGE
  VALIDATING_SCRIPT
  RUNNING_TEST
  COMPLETED
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         UserRole  @default(MEMBER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  sessions      Session[]
  requestedRuns TestRun[]
  aiExecutions  AiExecution[]

  @@index([deletedAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id                     String    @id @default(cuid())
  name                   String
  description            String?
  baseUrl                String?
  githubPatEncrypted     String?
  githubPatAccount       String?
  giteePatEncrypted      String?
  giteePatAccount        String?
  automationInstructions String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  repositories         Repository[]
  variables            ProjectVariable[]
  features             Feature[]
  userStories          UserStory[]
  testGroups           TestCaseGroup[]
  testCases            TestCase[]
  aiExecutions         AiExecution[]
  aiDrafts             UserStoryDraft[]
  testCaseDraftBatches TestCaseDraftBatch[]

  @@index([deletedAt])
  @@index([updatedAt])
}

model Repository {
  id        String    @id @default(cuid())
  projectId String
  gitUrl    String
  branch    String
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, deletedAt])
}

model ProjectVariable {
  id          String       @id @default(cuid())
  projectId   String
  name        String
  value       String
  description String?
  kind        VariableKind @default(PLAIN)
  position    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, deletedAt])
}

model Feature {
  id             String    @id @default(cuid())
  projectId      String
  code           String    @unique
  name           String
  summary        String
  backgroundGoal String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  project      Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  userStories  UserStory[]
  aiExecutions AiExecution[]
  aiDrafts     UserStoryDraft[]

  @@index([projectId, deletedAt, updatedAt])
}

model UserStory {
  id                        String            @id @default(cuid())
  projectId                 String
  featureId                 String?
  code                      String            @unique
  title                     String
  asA                       String
  iWant                     String
  soThat                    String
  status                    RequirementStatus @default(DESIGN)
  businessRules             String?
  nonFunctionalRequirements String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  deletedAt                 DateTime?

  project              Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  feature              Feature?              @relation(fields: [featureId], references: [id], onDelete: Restrict)
  acceptanceCriteria   AcceptanceCriterion[]
  testCases            TestCase[]
  aiTestCaseExecutions AiExecution[]         @relation("AiTestCaseSourceUserStory")
  sourceDraft          UserStoryDraft?       @relation("ConfirmedUserStory")

  @@index([projectId, deletedAt, updatedAt])
  @@index([featureId, deletedAt])
}

model AcceptanceCriterion {
  id          String    @id @default(cuid())
  userStoryId String
  position    Int
  given       String
  when        String
  then        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  userStory UserStory @relation(fields: [userStoryId], references: [id], onDelete: Restrict)

  @@index([userStoryId, deletedAt, position])
}

model TestCaseGroup {
  id        String    @id @default(cuid())
  projectId String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  testCases      TestCase[]
  testCaseDrafts TestCaseDraft[]

  @@index([projectId, deletedAt])
}

model TestCase {
  id                  String                @id @default(cuid())
  projectId           String
  groupId             String
  userStoryId         String?
  code                String                @unique
  name                String
  priority            TestPriority          @default(P2)
  preconditions       String?
  steps               String
  enabled             Boolean               @default(true)
  script              String?
  scriptSource        TestCaseScriptSource?
  aiScriptFingerprint String?
  scriptGeneratedAt   DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  deletedAt           DateTime?

  project      Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  group        TestCaseGroup  @relation(fields: [groupId], references: [id], onDelete: Restrict)
  userStory    UserStory?     @relation(fields: [userStoryId], references: [id], onDelete: Restrict)
  runs         TestRun[]
  aiExecutions AiExecution[]
  sourceDraft  TestCaseDraft? @relation("ConfirmedTestCase")

  @@index([projectId, deletedAt, updatedAt])
  @@index([groupId, deletedAt])
  @@index([userStoryId, deletedAt])
}

model TestRun {
  id                       String       @id @default(cuid())
  testCaseId               String
  requestedById            String
  status                   RunStatus    @default(QUEUED)
  stage                    TestRunStage @default(QUEUED)
  queuedAt                 DateTime     @default(now())
  startedAt                DateTime?
  finishedAt               DateTime?
  durationMs               Int?
  exitCode                 Int?
  errorSummary             String?
  logContent               String?
  screenshotPath           String?
  artifactsExpireAt        DateTime
  artifactsPurgedAt        DateTime?
  cancelRequestedAt        DateTime?
  workerId                 String?
  testCaseCodeSnapshot     String
  testCaseNameSnapshot     String
  scriptSnapshot           String?
  baseUrlSnapshot          String
  generatedScriptInRun     Boolean      @default(false)
  modelProfileNameSnapshot String?
  modelIdSnapshot          String?
  skillNameSnapshot        String?
  skillVersionSnapshot     String?
  promptTokens             Int?
  completionTokens         Int?
  totalTokens              Int?
  deletedAt                DateTime?

  testCase    TestCase @relation(fields: [testCaseId], references: [id], onDelete: Restrict)
  requestedBy User     @relation(fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([status, deletedAt, queuedAt])
  @@index([testCaseId, deletedAt, queuedAt])
  @@index([artifactsExpireAt, artifactsPurgedAt])
}

model BusinessCodeSequence {
  prefix        String   @id
  lastTimestamp BigInt
  updatedAt     DateTime @updatedAt
}

model AiModelProfile {
  id              String             @id @default(cuid())
  name            String
  baseUrl         String
  modelId         String
  apiKeyEncrypted String
  lastCheckStatus AiModelCheckStatus @default(UNCHECKED)
  lastCheckedAt   DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?

  capabilityBindings AiCapabilityBinding[]

  @@index([deletedAt, name])
}

model AiCapabilityBinding {
  capability     AiCapability @id
  modelProfileId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  modelProfile AiModelProfile @relation(fields: [modelProfileId], references: [id], onDelete: Restrict)

  @@index([modelProfileId])
}

model AiExecution {
  id                       String            @id @default(cuid())
  projectId                String
  requestedById            String
  featureId                String?
  sourceUserStoryId        String?
  testCaseId               String?
  capability               AiCapability
  status                   AiExecutionStatus @default(QUEUED)
  stage                    AiExecutionStage  @default(QUEUED)
  requirementText          String
  modelProfileNameSnapshot String?
  modelIdSnapshot          String?
  skillNameSnapshot        String?
  skillVersionSnapshot     String?
  repositorySnapshot       String?
  codeReferences           String?
  promptTokens             Int?
  completionTokens         Int?
  totalTokens              Int?
  errorMessage             String?
  queuedAt                 DateTime          @default(now())
  startedAt                DateTime?
  finishedAt               DateTime?
  durationMs               Int?
  workerId                 String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  deletedAt                DateTime?

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  requestedBy        User                @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  feature            Feature?            @relation(fields: [featureId], references: [id], onDelete: Restrict)
  sourceUserStory    UserStory?          @relation("AiTestCaseSourceUserStory", fields: [sourceUserStoryId], references: [id], onDelete: Restrict)
  testCase           TestCase?           @relation(fields: [testCaseId], references: [id], onDelete: Restrict)
  draft              UserStoryDraft?
  testCaseDraftBatch TestCaseDraftBatch?
  logs               AiExecutionLog[]

  @@index([status, queuedAt])
  @@index([projectId, deletedAt, queuedAt])
  @@index([featureId])
  @@index([sourceUserStoryId])
  @@index([testCaseId])
}

model AiExecutionLog {
  id          String              @id @default(cuid())
  executionId String
  position    Int
  level       AiExecutionLogLevel
  stage       AiExecutionStage?
  message     String
  createdAt   DateTime            @default(now())

  execution AiExecution @relation(fields: [executionId], references: [id], onDelete: Restrict)

  @@unique([executionId, position])
  @@index([executionId, createdAt])
}

model UserStoryDraft {
  id                        String        @id @default(cuid())
  projectId                 String
  featureId                 String?
  sourceExecutionId         String        @unique
  confirmedUserStoryId      String?       @unique
  status                    AiDraftStatus @default(PENDING)
  title                     String
  asA                       String
  iWant                     String
  soThat                    String
  businessRules             String?
  nonFunctionalRequirements String?
  confirmedAt               DateTime?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  deletedAt                 DateTime?

  project            Project                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  feature            Feature?                   @relation(fields: [featureId], references: [id], onDelete: Restrict)
  sourceExecution    AiExecution                @relation(fields: [sourceExecutionId], references: [id], onDelete: Restrict)
  confirmedUserStory UserStory?                 @relation("ConfirmedUserStory", fields: [confirmedUserStoryId], references: [id], onDelete: Restrict)
  acceptanceCriteria DraftAcceptanceCriterion[]

  @@index([projectId, deletedAt, updatedAt])
  @@index([featureId, deletedAt])
}

model DraftAcceptanceCriterion {
  id        String    @id @default(cuid())
  draftId   String
  position  Int
  given     String
  when      String
  then      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  draft UserStoryDraft @relation(fields: [draftId], references: [id], onDelete: Restrict)

  @@index([draftId, deletedAt, position])
}

model TestCaseDraftBatch {
  id                String    @id @default(cuid())
  projectId         String
  sourceExecutionId String    @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  project         Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  sourceExecution AiExecution     @relation(fields: [sourceExecutionId], references: [id], onDelete: Restrict)
  drafts          TestCaseDraft[]

  @@index([projectId, deletedAt, updatedAt])
}

model TestCaseDraft {
  id                  String        @id @default(cuid())
  batchId             String
  groupId             String?
  confirmedTestCaseId String?       @unique
  position            Int
  name                String
  priority            TestPriority
  preconditions       String?
  steps               String
  status              AiDraftStatus @default(PENDING)
  confirmedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  batch             TestCaseDraftBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  group             TestCaseGroup?     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  confirmedTestCase TestCase?          @relation("ConfirmedTestCase", fields: [confirmedTestCaseId], references: [id], onDelete: Restrict)

  @@index([batchId, deletedAt, position])
  @@index([groupId, deletedAt])
  @@index([status, deletedAt])
}

model TaskSchedulerLease {
  id        String   @id
  ownerId   String
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}
