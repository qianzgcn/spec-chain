{
  "name": "spec-chain",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.11.1",
  "engines": {
    "node": "22.22.x",
    "npm": "11.11.x"
  },
  "scripts": {
    "dev": "prisma migrate deploy && prisma db seed && next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && prisma db seed && next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "browser:install": "playwright install chromium",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate && npm run browser:install"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.16",
    "@base-ui/react": "^1.6.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@hookform/resolvers": "^5.5.7",
    "@node-rs/argon2": "^2.0.2",
    "@playwright/cli": "0.1.17",
    "@playwright/test": "1.62.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@uiw/react-codemirror": "^4.25.11",
    "ai": "^7.0.41",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "pino": "^10.3.1",
    "playwright": "1.62.0",
    "prisma": "^7.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.16.0",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion@1": "1.1.17",
    "next": {
      "postcss": "8.5.24",
      "sharp": "0.35.3"
    }
  }
}
