# SQLite 数据库地址。容器部署时建议挂载 /data 目录。
DATABASE_URL="file:./data/specchain.db"

# 首次初始化时创建的管理员账号。
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="请设置至少8位的安全密码"

# 32 字节随机密钥的 Base64 编码，用于加密项目敏感变量。
# 可使用：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY="请替换为32字节随机密钥的Base64编码"

# 会话 Cookie 在生产 HTTPS 环境中必须设为 true。
SESSION_COOKIE_SECURE="false"

# 普通 AI 任务和浏览器任务分别使用独立资源池，取值范围为 1～16。
AI_TASK_CONCURRENCY="2"
BROWSER_TASK_CONCURRENCY="2"

# Docker Compose 暴露到宿主机的端口；本地直接运行时不使用。
SPECCHAIN_PORT="3000"
